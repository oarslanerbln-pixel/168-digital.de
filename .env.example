# Copy this file to .env.local (gitignored) for local development,
# and set the same keys in Vercel → Project → Settings → Environment Variables
# for production. Both are optional — leaving either blank simply skips that
# provider (see src/utils/thirdPartyAnalytics.ts). Neither script loads for a
# visitor until they click "Alle Akzeptieren" in the cookie banner.

# Google Analytics 4 — Measurement ID from
# Google Analytics → Admin → Data Streams → your web stream (format: G-XXXXXXXXXX)
VITE_GA4_ID=

# Meta (Facebook/Instagram) Pixel ID from
# Meta Events Manager → Data Sources → your pixel (numeric ID)
VITE_META_PIXEL_ID=
